# Copy to .env (never commit it). Everything here is optional.
TZ=UTC

# Timelapses on a NAS (SMB share) instead of the local "output" volume:
# uncomment COMPOSE_FILE and fill in the share. Use the NAS IP; the Docker
# host may not resolve the NetBIOS name.
# COMPOSE_FILE=docker-compose.yml:docker-compose.nas.yml
NAS_SHARE=//192.168.1.10/Media
NAS_USER=
NAS_PASSWORD=
